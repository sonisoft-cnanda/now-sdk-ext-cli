{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Execute Command",
      "skipFiles": ["<node_internals>/**"],
      "runtimeExecutable": "node",
      "runtimeArgs": ["--loader", "ts-node/esm", "--no-warnings=ExperimentalWarning"],
      "program": "${workspaceFolder}/bin/dev.js",
      "args": ["exec global examples/scripts/test.js -auth dev-instance"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Execute Command - App Uninstall",
      "skipFiles": ["<node_internals>/**"],
      "runtimeExecutable": "node",
      "runtimeArgs": ["--loader", "ts-node/esm", "--no-warnings=ExperimentalWarning"],
      "program": "${workspaceFolder}/bin/dev.js",
      "args": ["app -u -a dev-instance -i 00000000000000000000000000000000 -s x_acme_app"]
    }
  ]
}
